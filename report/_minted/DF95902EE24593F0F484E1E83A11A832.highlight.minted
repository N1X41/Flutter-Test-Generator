// \PYGZhy{}\PYGZhy{}\PYGZhy{} Заглушки Cubit и состояний для контекста \PYGZhy{}\PYGZhy{}\PYGZhy{}
abstract class LoginState \PYGZob{}\PYGZcb{}
class LoginInitial extends LoginState \PYGZob{}\PYGZcb{}
class LoginLoading extends LoginState \PYGZob{}\PYGZcb{}
class LoginSuccess extends LoginState \PYGZob{}
  final String token;
  LoginSuccess(this.token);
  @override bool operator ==(Object other) =\PYGZgt{} other is LoginSuccess \PYGZam{}\PYGZam{} token == other.token;
  @override int get hashCode =\PYGZgt{} token.hashCode;
\PYGZcb{}
class LoginFailure extends LoginState \PYGZob{}
  final String error;
  LoginFailure(this.error);
   @override bool operator ==(Object other) =\PYGZgt{} other is LoginFailure \PYGZam{}\PYGZam{} error == other.error;
   @override int get hashCode =\PYGZgt{} error.hashCode;
\PYGZcb{}

// Пример зависимости
abstract class AuthRepository \PYGZob{}
