class LoginCubit extends Cubit\PYGZlt{}LoginState\PYGZgt{} \PYGZob{}
  // final AuthRepository authRepository; // Пример зависимости

  LoginCubit(/*this.authRepository*/) : super(LoginInitial());

  Future\PYGZlt{}void\PYGZgt{} loginUser(String username, String password) async \PYGZob{}
    if (state is LoginLoading) return; // Предотвращение параллельных логинов
    emit(LoginLoading());
    try \PYGZob{}
      // Симуляция API вызова
      // final token = await authRepository.login(username, password);
      await Future.delayed(Duration(milliseconds: 10)); // Симуляция задержки
      if (username == \PYGZsq{}user\PYGZsq{} \PYGZam{}\PYGZam{} password == \PYGZsq{}pass\PYGZsq{}) \PYGZob{}
         final token = \PYGZsq{}fake\PYGZhy{}token\PYGZhy{}123\PYGZsq{};
         emit(LoginSuccess(token));
      \PYGZcb{} else \PYGZob{}
         throw Exception(\PYGZsq{}Invalid credentials\PYGZsq{});
      \PYGZcb{}
    \PYGZcb{} catch (e) \PYGZob{}
      emit(LoginFailure(e.toString()));
    \PYGZcb{}
  \PYGZcb{}

  void logout() \PYGZob{}
     if (state is LoginSuccess) \PYGZob{}
        emit(LoginInitial());
     \PYGZcb{}
     // Опционально: обработка logout из других состояний?
  \PYGZcb{}

   void reset() \PYGZob{}
      emit(LoginInitial());
   \PYGZcb{}
\PYGZcb{}
