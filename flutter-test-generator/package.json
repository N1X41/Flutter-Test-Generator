{
  "name": "flutter-test-generator",
  "displayName": "Flutter Test Generator",
  "description": "Автоматическая генерация unit-тестов для приложений Flutter",
  "version": "0.0.1",
  "publisher": "n1x",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:dart",
    "onCommand:flutterTestGenerator.generateTest"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flutterTestGenerator.generateTest",
        "title": "Generate Test",
        "category": "Flutter"
      }
    ],
    "codeActions": [
      {
        "command": "flutterTestGenerator.generateTest",
        "title": "Flutter: Generate Test",
        "kind": "refactor",
        "description": "Generate a unit test for the selected method, DTO, or Cubit"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "flutterTestGenerator.generateTest",
          "when": "editorLangId == dart"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Flutter Test Generator",
      "properties": {
        "flutterTestGenerator.testDir": {
          "type": "string",
          "default": "test",
          "description": "Базовая директория для тестовых файлов."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^14.18.0",
    "@types/vscode": "^1.60.0",
    "js-yaml": "^4.1.0",
    "typescript": "^4.2.3"
  }
}
